# 忽略密钥文件 (千万不能传)
.env

# 忽略编译生成的二进制文件
baseline
matrix_mul
a.out
*.exe

# 忽略测试生成的二进制可执行文件（async_eval.py: nvcc ... -o test_{size}）
test_[0-9]*

# 忽略测试生成的临时 CUDA 源码（async_eval.py / test_api.py 写入）
matrix_mul*.cu

# 忽略日志文件
*.log

# 忽略矩阵校验产生的二进制输出
*.bin
__pycache__/

# 画像/分类/反馈证据链落盘目录（运行时产物）
results/

# R3 自蒸馏候选卡（运行时产物，人工 review 后合并进 strategies/）
knowledge/candidates/
